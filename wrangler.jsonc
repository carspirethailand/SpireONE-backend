{
  "name": "spireonebackend",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "sp1p-82396",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_SEARCH_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_LIVE_MODEL": "gemini-3.1-flash-live-preview",
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com",
    "OWNERS": "anapatmaliwong@gmail.com,carspirethailand@gmail.com",
    "AI_DAILY_LIMIT": "60",
    "AI_ANON_DAILY_LIMIT": "15",
    "ALLOWED_ORIGINS": "*",
    "CEREBRAS_MODEL": "gpt-oss-120b",
    "CEREBRAS_BASE_URL": "https://api.cerebras.ai/v1",
    "GROQ_MODEL": "llama-3.1-8b-instant",
    "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
    "OPENROUTER_MODEL": "openrouter/free",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "CF_AI_FALLBACK_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  // smart placement เคยพา worker ไปรันในพื้นที่ที่ Gemini ไม่รองรับ (400 "User location is not supported")
  // ล็อกไว้ที่สหรัฐฯ ซึ่ง Gemini/Google/Bing ใช้ได้แน่นอน
  "placement": {
    "region": "gcp:us-east4"
  },
  "triggers": {
    "crons": [
      "0 17 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spireone",
      "database_id": "bf9b1815-2ef6-4463-8b35-6b97717b5d9a"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}